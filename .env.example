# ── 監聽 ──────────────────────────────────────────────
SSH_HOST=0.0.0.0
SSH_PORT=2222

# ── 身分與金鑰 ────────────────────────────────────────
# 路徑只是檔名：ssh-keygen 可用時生成 ssh-ed25519，否則 fallback 為 ecdsa-sha2-nistp256
SSH_HOST_KEY_PATH=./keys/ssh_host_ed25519_key
SSH_USERS_FILE=./config/users.json
SSH_COMMANDS_FILE=./config/commands.json

# ── 開發用 bootstrap 憑證 ─────────────────────────────
# 僅在 NODE_ENV != production 且 config/users.json 不存在時，由 start.js 寫入第一位使用者
# 密碼需 >= 8 字元且 <= 72 bytes（bcrypt 上限，超出會被靜默截斷）
SSH_DEFAULT_USERNAME=deploy
SSH_DEFAULT_PASSWORD=ChangeMe123!

# ── SFTP ──────────────────────────────────────────────
# 虛擬根目錄；未設定時為機器根目錄。SSH_SFTP_FOLLOW_SHELL_CWD=false 時此路徑即沙箱根
# SSH_SFTP_ROOT=/app/s12ryt
# true（預設）：SFTP 跟隨互動 shell 的 cwd 且不受沙箱限制，
# 可讀寫服務帳號能存取的整個檔案系統，只提供給完全可信的帳號。
# 需要沙箱時設為 false，並同時設定 SSH_SFTP_ROOT。
SSH_SFTP_FOLLOW_SHELL_CWD=true

# ── 互動 Shell ────────────────────────────────────────
# true（預設）等同開放該服務帳號的任意命令執行能力
SSH_ENABLE_SHELL=true
# SSH_SHELL_PATH=/bin/bash

# ── 連線限額（阻斷服務與暴力破解防護）────────────────
SSH_MAX_CLIENTS=64
SSH_MAX_CLIENTS_PER_IP=8
SSH_MAX_AUTH_FAILURES=5
SSH_MAX_SESSIONS_PER_CLIENT=8
SSH_READY_TIMEOUT_MS=20000

# ── 日誌 ──────────────────────────────────────────────
SSH_LOG_LEVEL=info
