SSH_HOST=0.0.0.0
SSH_PORT=2222
SSH_DEFAULT_USERNAME=deploy
SSH_DEFAULT_PASSWORD=ChangeMe123!
SSH_HOST_KEY_PATH=./keys/ssh_host_ed25519_key
SSH_USERS_FILE=./config/users.json
SSH_COMMANDS_FILE=./config/commands.json
SSH_SFTP_ROOT=./s12ryt
SSH_SFTP_FOLLOW_SHELL_CWD=true
SSH_ENABLE_SHELL=true
# SSH_SHELL_PATH=/bin/bash
SSH_SHELL_CWD=./s12ryt
SSH_MAX_CLIENTS=3
SSH_READY_TIMEOUT_MS=20000
SSH_LOG_LEVEL=info

# Optional QEMU TCG VM. Blank values use the documented defaults.
VM_ENABLED=false
VM_QEMU_BINARY=
VM_QEMU_IMG_BINARY=
VM_QEMU_AUTO_INSTALL=true
VM_QEMU_RUNTIME_PATH=./vm/runtime
VM_QEMU_INSTALL_TIMEOUT_MS=900000
VM_ARCH=amd64
VM_IMAGE_PATH=./vm/debian-12-genericcloud-amd64.qcow2
VM_IMAGE_URL=
VM_IMAGE_CHECKSUM_URL=
VM_RAM_MB=1024
VM_CPU_LIMIT=1.0
VM_DISK_GB=10
VM_MIN_HOST_FREE_GB=2.0
VM_SSH_HOST=0.0.0.0
VM_SSH_HOST_PORT=2223
VM_SSH_USERNAME=root
VM_SSH_PASSWORD=ChangeMe123!
VM_SSH_AUTHORIZED_KEY=
VM_HOSTNAME=s12ryt-vm
VM_SHUTDOWN_TIMEOUT_MS=30000
VM_METADATA_TIMEOUT_MS=300000
VM_DOWNLOAD_TIMEOUT_MS=900000
